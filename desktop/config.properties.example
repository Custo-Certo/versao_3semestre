# =====================================================================
# Custo Certo - Desktop | Exemplo de configuracao local
# =====================================================================
# Copie este arquivo para "config.properties" NESTA PASTA (desktop/) e
# preencha com os dados do MySQL que voce esta usando.
#
#   cp config.properties.example config.properties      (Git Bash)
#   copy config.properties.example config.properties    (Prompt / PowerShell)
#
# O arquivo config.properties esta no .gitignore e nao vai para o repositorio.

# Maquina onde o MySQL esta rodando.
# Durante o desenvolvimento, cada um usa localhost.
# Na demonstracao de acesso via rede local, todos apontam para o IP da
# maquina que estiver servindo o banco (descubra com "ipconfig" nela).
db.host=localhost
db.porta=3306
db.nome=custo_certo

db.usuario=root
db.senha=SUA_SENHA_DO_MYSQL

db.parametros=useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Sao_Paulo&characterEncoding=UTF-8&connectTimeout=3000&socketTimeout=15000

# Endereco de onde o app le o peso AO VIVO da balanca.
# A balanca (ESP32) ENVIA o peso para o servidor Java, e o app consome esse
# peso do servidor no endpoint /balanca/peso (e zera em /balanca/tara). Por isso
# aponte para o MESMO servidor do banco, na porta 3000, com o caminho /balanca:
#   - Desenvolvendo sozinho (servidor nesta maquina): http://localhost:3000/balanca
#   - Em rede local: http://<IP do servidor>:3000/balanca  (o mesmo IP do db.host)
# Obs.: e uma conexao de SAIDA, nao precisa liberar porta no Firewall do cliente.
balanca.url=http://localhost:3000/balanca
